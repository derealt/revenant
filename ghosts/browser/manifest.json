{
  "manifest_version": 3,
  "name": "REVENANT Ghost",
  "version": "0.1.0",
  "description": "Cognitive context restoration — shows what you were doing when you last visited this page",
  "permissions": ["activeTab", "storage", "nativeMessaging"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "css": ["src/ghost.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "REVENANT Ghost",
    "default_popup": "src/popup.html"
  },
  "icons": {},
  "host_permissions": []
}
