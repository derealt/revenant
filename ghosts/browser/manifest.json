{
  "manifest_version": 3,
  "name": "REVENANT Ghost",
  "version": "0.3.0",
  "description": "Cognitive context restoration - shows what you were doing when you last visited this page",
  "permissions": ["activeTab", "tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["ghost.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "REVENANT Ghost",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": ["http://127.0.0.1:7711/*"]
}
